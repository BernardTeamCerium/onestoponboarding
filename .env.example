# ---------------------------------------------------------------------------
# GoHighLevel — API route (recommended)
# ---------------------------------------------------------------------------
# Settings -> Private Integrations -> create a token with these scopes:
#   contacts.readonly, contacts.write, objects/record.write (notes)
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Settings -> Business Profile -> Location ID (also called Sub-Account ID)
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# GoHighLevel — inbound webhook (optional, but recommended alongside the API)
# ---------------------------------------------------------------------------
# Automation -> Workflows -> new workflow -> trigger "Inbound Webhook".
# Every questionnaire answer arrives as a workflow variable, so you can drop
# them straight into email and SMS templates.
GHL_INBOUND_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Shown as the contact's Source in GoHighLevel.
GHL_SOURCE=Advisor Onboarding Page

# Extra tags added to every submission, comma separated (e.g. a campaign tag).
GHL_EXTRA_TAGS=

# Map questionnaire fields to GoHighLevel custom field IDs, as JSON.
# Without this the answers still arrive in full as a note on the contact.
# GHL_CUSTOM_FIELDS={"firmName":"AbC123","services":"DeF456","primaryGoal":"GhI789"}
GHL_CUSTOM_FIELDS=

# Booking link shown on the thank-you screen (GoHighLevel calendar, Calendly...).
# Leave blank to show the phone number and email instead.
NEXT_PUBLIC_BOOKING_URL=

# Override only if you are on a non-default GoHighLevel API host/version.
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
