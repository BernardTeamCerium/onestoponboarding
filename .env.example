# ===========================================================================
# Storage — where submissions are kept (the system of record)
# ===========================================================================
# Any Postgres works: Neon, Supabase, Vercel Postgres, or your own.
# Without it the app still runs, but nothing is stored and the /admin
# dashboard has nothing to show.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password for the /admin submissions dashboard. Without it the dashboard is
# disabled entirely. Use something long and random.
ADMIN_PASSWORD=

# ===========================================================================
# Team notification email (optional)
# ===========================================================================
# Emails every submission to your team. Get an API key at resend.com and
# verify the sending domain first.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
NOTIFY_EMAIL_FROM=onboarding@onestopprintco.com
# Who receives the notification. Comma-separate for several recipients.
NOTIFY_EMAIL_TO=Info@onestopprintco.com

# Public URL of the deployed site. Used to link from the notification email
# straight to the submission in the dashboard.
NEXT_PUBLIC_SITE_URL=https://onboarding.onestopprintco.com

# ===========================================================================
# GoHighLevel (entirely optional — leave blank to run standalone)
# ===========================================================================
# Set these later and submissions start flowing to your CRM as well, with no
# code change. Settings -> Private Integrations, with scopes
# contacts.readonly, contacts.write and objects/record.write.
GHL_API_TOKEN=
# Settings -> Business Profile -> Location ID.
GHL_LOCATION_ID=
# Automation -> Workflows -> trigger "Inbound Webhook". Makes every answer
# available as a workflow variable for email and SMS templates.
GHL_INBOUND_WEBHOOK_URL=

# Shown as the contact's Source in GoHighLevel.
GHL_SOURCE=Digital Presence Onboarding
# Extra tags added to every submission, comma separated.
GHL_EXTRA_TAGS=
# Map questionnaire fields to GoHighLevel custom field IDs, as JSON.
# GHL_CUSTOM_FIELDS={"firmName":"AbC123","currentSite":"DeF456"}
GHL_CUSTOM_FIELDS=

# ===========================================================================
# Optional
# ===========================================================================
# Booking link shown on the thank-you screen. Leave blank to show the phone
# number and email instead.
NEXT_PUBLIC_BOOKING_URL=

# Override only if you are on a non-default GoHighLevel API host/version.
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
